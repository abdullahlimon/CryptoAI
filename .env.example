# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (router falls back in this order: Groq → Gemini → Ollama) ---
# Groq: free, fast, Llama 3.3 70B / Mixtral. https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini: free tier, Gemini 2.0 Flash. https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama: local fallback. Run `ollama serve` + `ollama pull llama3.1`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Pick default provider: groq | gemini | ollama | auto (auto = first available)
AI_DEFAULT_PROVIDER=auto

# --- Optional data providers ---
# CoinGecko works without a key on free tier (rate-limited).
# Add a demo key to raise limits: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=
CRYPTOPANIC_API_KEY=
